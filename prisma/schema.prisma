generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

//--------------------------------------------------------------------------------

// ============================================
// SUPER ADMIN
// ============================================

model SuperAdmin {
  id        String   @id @default(uuid())
  email     String   @unique
  name      String
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@map("super_admins")
}

// ============================================
// INSTRUCTOR (كان اسمه Admin قبل كده)
// ============================================

model Instructor {
  id        String   @id @default(uuid())
  email     String   @unique
  name      String
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  // Relations
  instructorGroups InstructorGroup[]

  @@map("instructors")
}

// ============================================
// STUDENT
// ============================================

model Student {
  id         String   @id // كود الطالب اللي بيستخدمه كـ"باسورد" - مش auto-generated
  email      String   @unique
  name       String
  groupId    String
  avgSt      Int      @default(50) // متوسط (Math.round) كل LevelStBalance.balance بتاعة الطالب عبر كل الـ Levels (المجمدة + الحالية) - عمود cache محسوب، بيتحدث atomically جوه applySTChange - INTERMEDIATE فقط، يفضل 50 لطالب BEGINNER (بيتجاهل)
  beginnerSt Int? // BEGINNER فقط - رقم واحد بيتراكم طول الـ course كله، مفيش تجميد ولا متوسط زي levelSt. null لطالب INTERMEDIATE
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  // Relations
  group                   Group                    @relation(fields: [groupId], references: [id])
  submissions             Submission[]
  hintUnlocks             HintUnlock[]
  attendance              Attendance[]
  stTransactions          STTransaction[]
  storeInventory          StudentInventory[]
  levelStBalances         LevelStBalance[] // INTERMEDIATE فقط
  weekResourceSubmissions WeekResourceSubmission[] // BEGINNER فقط

  @@map("students")
}

// ============================================
// BATCH
// ============================================

model Batch {
  id        String   @id @default(uuid())
  name      String
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  // Relations
  groups Group[]

  @@map("batches")
}

// ============================================
// GROUP TYPE ENUM
// ============================================
// INTERMEDIATE: النظام الحالي بالظبط - Level -> Session -> Task -> Hint
// BEGINNER: نظام جديد - Week -> Task -> Hint (مفيش Level ولا Session خالص)

enum GroupType {
  BEGINNER
  INTERMEDIATE
}

// ============================================
// GROUP
// ============================================

model Group {
  id        String    @id @default(uuid())
  name      String
  batchId   String
  type      GroupType @default(INTERMEDIATE)
  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt

  // Relations
  batch            Batch             @relation(fields: [batchId], references: [id])
  students         Student[]
  instructorGroups InstructorGroup[]
  levels           Level[] // INTERMEDIATE فقط
  weeks            Week[] // BEGINNER فقط

  @@map("groups")
}

// ============================================
// INSTRUCTOR_GROUP (كان اسمه AdminGroup قبل كده)
// ============================================

model InstructorGroup {
  id           String   @id @default(uuid())
  instructorId String
  groupId      String
  createdAt    DateTime @default(now())

  // Relations
  instructor Instructor @relation(fields: [instructorId], references: [id], onDelete: Cascade)
  group      Group      @relation(fields: [groupId], references: [id], onDelete: Cascade)

  @@unique([instructorId, groupId])
  @@map("instructor_groups")
}

//--------------------------------------------------------------------------------

// ============================================
// LEVEL
// ============================================
// كل Group ليه الـ Levels الخاصة بيه (مش جدول عام مشترك).
// في أي لحظة، Level واحد بس isActive = true لكل Group.
// لما الـ Instructor "ينقل" الـ Group لـ Level جديد:
//   1) الـ Level الحالي isActive -> false (رصيده في LevelStBalance يفضل
//      كما هو - "متجمد"، مش بيتصفّر أو يتلمس تاني)
//   2) Level جديد بيتعمل/يتفعّل بـ isActive = true و startDate = now()
//   3) كل طالب في الـ Group ياخد صف جديد في LevelStBalance لهذا الـ
//      Level بـ balance = 50، و Student.avgSt بتاعه بيتحسب من جديد

model Level {
  id          String   @id @default(uuid())
  groupId     String
  name        String
  description String?
  levelNumber Int
  startDate   DateTime @default(now())
  isActive    Boolean  @default(true)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  // Relations
  group           Group            @relation(fields: [groupId], references: [id], onDelete: Cascade)
  sessions        Session[]
  stTransactions  STTransaction[]
  levelStBalances LevelStBalance[]

  @@map("levels")
}

// ============================================
// LEVEL ST BALANCE
// ============================================
// رصيد ST مستقل لكل (Student × Level). صف بيتعمل مرة واحدة لما الطالب
// يدخل Level (balance = 50 دايمًا في البداية)، وبعد كده applySTChange
// بيعمل عليه increment/decrement زي levelSt القديم بالظبط - لكن هنا
// بيفضل الرصيد ده "متجمد" ومحفوظ لما الطالب ينتقل لـ Level تانية،
// بدل ما يتصفّر ويضيع.
//
// Student.avgSt = Math.round(average(كل صفوف LevelStBalance بتاعة
// الطالب دي)) - محسوب ومخزّن على الطالب كـ cache، بيتحدث في نفس
// الـ $transaction بتاع applySTChange.

model LevelStBalance {
  id        String   @id @default(uuid())
  studentId String
  levelId   String
  balance   Int      @default(50) // مفيش حد أدنى (ممكن تطلع سالبة)، زي levelSt القديم بالظبط
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  // Relations
  student Student @relation(fields: [studentId], references: [id], onDelete: Cascade)
  level   Level   @relation(fields: [levelId], references: [id], onDelete: Cascade)

  @@unique([studentId, levelId])
  @@map("level_st_balances")
}

// ============================================
// WEEK (BEGINNER track only)
// ============================================
// المكافئ لـ Level في نظام الـ BEGINNER - بس مفيش levelNumber ولا
// isActive ولا تجميد رصيد. اسمها "Week" بناءً على طلب صريح من
// الـ owner، لكنها مش أسبوع تقويمي حقيقي - الـ Instructor بيحدد
// startDate/endDate بحرية (أي مدة).
//
// كل Week ليها playlist واحد (لينك يوتيوب) وملف مطلوب واحد لازم كل
// طالب يرفعه قبل endDate (منفصل تمامًا عن أي Task submission - انظر
// WeekResourceSubmission تحت).
//
// مفيش Session في نظام الـ BEGINNER خالص - Task تتبع لـ Week مباشرة.
// مفيش attendance/engagement كمان - الطالب مسؤول عن نفسه في متابعة
// الـ playlist وحل الـ Tasks، والـ Instructor بيراجع كل حاجة holistically
// وقت الـ grading (مش بحضور live).

model Week {
  id                String   @id @default(uuid())
  groupId           String
  name              String
  startDate         DateTime
  endDate           DateTime
  playlistUrl       String
  requiredFileLabel String // وصف الملف المطلوب (مثلاً "تقرير نهاية الفترة")
  createdAt         DateTime @default(now())
  updatedAt         DateTime @updatedAt

  // Relations
  group               Group                    @relation(fields: [groupId], references: [id], onDelete: Cascade)
  tasks               Task[]
  resourceSubmissions WeekResourceSubmission[]
  stTransactions      STTransaction[]

  @@map("weeks")
}

// ============================================
// WEEK RESOURCE SUBMISSION (BEGINNER track only)
// ============================================
// الملف المطلوب بتاع الـ Week - منفصل تمامًا عن أي Submission بتاعة
// Task. صف واحد بس لكل (studentId, weekId) - الطالب يقدر يرفع/يستبدل
// الملف براحته لحد ما الـ Instructor يحسم status بتاعه وقت الـ grading
// (انظر شاشة الـ grading الموحدة في instructor-events / grade-week.ts).
//
// status بيتحدد بمعرفة الـ Instructor كجزء من نفس شاشة تقييم الـ Week
// (مش شاشة منفصلة) - PENDING لحد ما يقيّم، وبعدين ACCEPTED أو REJECTED
// بشكل نهائي (زي باقي الـ grading، مفيش تعديل بعد الحسم).

enum WeekResourceStatus {
  PENDING
  ACCEPTED
  REJECTED
}

model WeekResourceSubmission {
  id          String             @id @default(uuid())
  studentId   String
  weekId      String
  fileUrl     String?
  status      WeekResourceStatus @default(PENDING)
  submittedAt DateTime?
  createdAt   DateTime           @default(now())
  updatedAt   DateTime           @updatedAt

  // Relations
  student Student @relation(fields: [studentId], references: [id], onDelete: Cascade)
  week    Week    @relation(fields: [weekId], references: [id], onDelete: Cascade)

  @@unique([studentId, weekId])
  @@map("week_resource_submissions")
}

// ============================================
// SESSION
// ============================================
// موعد فعلي (تاريخ + وقت + مدة) تابع لـ Level معيّن.
// الـ status (upcoming/ongoing/completed) بيتحسب runtime من
// startTime و durationMinutes، مش عمود مخزّن.

model Session {
  id              String   @id @default(uuid())
  levelId         String
  title           String
  startTime       DateTime
  durationMinutes Int
  recordingLink   String?
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  // Relations
  level      Level        @relation(fields: [levelId], references: [id], onDelete: Cascade)
  tasks      Task[]
  attendance Attendance[]

  @@map("sessions")
}

// ============================================
// TASK TYPE ENUM
// ============================================
// INTERNAL: Task كاملة (Level 1) - ليها Submission + Hints
// EXTERNAL: Task خارجية (Level 2) - رابط خارجي بس + Hints

enum TaskType {
  INTERNAL
  EXTERNAL
}

// ============================================
// TASK
// ============================================
// كل Task تابعة لـ Session واحدة.
// deadline لازم يكون قبل بداية الـ Session اللي بعدها.
// isBonus بتفرّق الـ Task العادية عن الـ Bonus (بيأثر على الـ ST reward في Phase 4).

// ملحوظة معمارية (BEGINNER track): sessionId بقى optional، وweekId
// اتضاف optional كمان. "exactly one من الاتنين لازم يتحدد" مش DB
// constraint - بيتفرض جوه الـ Server Action وقت إنشاء الـ Task حسب
// نوع الـ Group (INTERMEDIATE -> sessionId، BEGINNER -> weekId).

model Task {
  id                    String          @id @default(uuid())
  sessionId             String? // مطلوب لـ INTERMEDIATE فقط
  weekId                String? // مطلوب لـ BEGINNER فقط
  title                 String
  description           String
  type                  TaskType
  deadline              DateTime
  isBonus               Boolean         @default(false)
  allowedSubmissionMode SubmissionMode? // null = الطالب يختار بحرّية (FILE/LINK/TEXT)، غير null = ده النوع الوحيد المسموح. لازم null دايمًا لو type = EXTERNAL (مفيش submissions أصلًا)
  createdAt             DateTime        @default(now())
  updatedAt             DateTime        @updatedAt

  // Relations
  session      Session?          @relation(fields: [sessionId], references: [id], onDelete: Cascade)
  week         Week?             @relation(fields: [weekId], references: [id], onDelete: Cascade)
  hints        Hint[]
  submissions  Submission[]
  rubricFields TaskRubricField[] // BEGINNER فقط - انظر التعريف تحت

  @@map("tasks")
}

// ============================================
// TASK RUBRIC FIELD (BEGINNER track only)
// ============================================
// الـ rubric بتاعة الـ Task في نظام الـ BEGINNER مش ثابتة زي INTERMEDIATE
// (understanding/approach/correctness/implementation بأوزان محددة سلفًا) -
// هنا الـ Instructor نفسه بيعرّف الحقول وقت أول تقييم لأي طالب في التاسك
// دي (مثلاً "implementation": 2, "understanding": 3, "solving": 4).
//
// أول ما الـ Instructor يعرّف الحقول دي لأول طالب، هي بتتطبق على كل
// الطلاب التانيين في نفس التاسك (rubric واحدة لكل Task، مش لكل طالب) -
// وهو يقدر يعدلها لاحقًا (قبل ما يخلص submit التقييم النهائي - انظر
// TaskGrade تحت). مجموع maxPoints لكل حقول التاسك الواحدة لازم يكون <= 10.

model TaskRubricField {
  id        String   @id @default(uuid())
  taskId    String
  fieldName String
  maxPoints Int
  order     Int // للعرض بس، بيحدد ترتيب الحقول في شاشة الـ grading
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  // Relations
  task       Task             @relation(fields: [taskId], references: [id], onDelete: Cascade)
  taskGrades TaskGradeField[]

  @@map("task_rubric_fields")
}

// ============================================
// HINT
// ============================================
// كل Task ليها بالظبط 3 Hints. مفيش ترتيب إجباري للفتح.
// cost بيتخصم مرة واحدة، وبعدها الـ Hint مفتوح للأبد لنفس الطالب
// (تتبّع "مين فتح إيه" هيبقى في HintUnlock - Phase 3).

model Hint {
  id        String   @id @default(uuid())
  taskId    String
  order     Int // 1, 2, or 3 - للعرض بس
  content   String
  cost      Int
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  // Relations
  task        Task         @relation(fields: [taskId], references: [id], onDelete: Cascade)
  hintUnlocks HintUnlock[]

  @@unique([taskId, order])
  @@map("hints")
}

//--------------------------------------------------------------------------------

// ============================================
// SUBMISSION MODE ENUM
// ============================================
// FILE: رفع ملف واحد (أي نوع، حد أقصى 5MB) على Supabase Storage
// LINK: رابط خارجي (مثلاً GitHub, CodeSandbox, ...)
// TEXT: نص ملصوق مباشرة

enum SubmissionMode {
  FILE
  LINK
  TEXT
}

// ============================================
// SUBMISSION STATUS ENUM (BEGINNER track only)
// ============================================
// INTERMEDIATE: كل Submission بتتعمل SUBMITTED فورًا زي ما هي دلوقتي -
// مفيش استخدام لـ DRAFT في مسارها.
// BEGINNER: الطالب يعمل "save" (DRAFT) براحته عدد مرات غير محدود طول
// الـ Week، وبعدين يتحول SUBMITTED إما يدوي (الطالب يقفل بنفسه، مفيش
// تعديل بعد كده) أو تلقائي (auto-submit) وقت Week.endDate لو لسه DRAFT.

enum SubmissionStatus {
  DRAFT
  SUBMITTED
}

// ============================================
// SUBMISSION
// ============================================
// Row واحد بس لكل (studentId, taskId) - unique constraint.
// الـ resubmit = UPDATE على نفس الـ row (submittedAt بيتحدث تلقائيًا)،
// المحتوى القديم بيتمسح، مفيش history table.
//
// الـ resubmit بيتمنع لو:
//   1) الـ deadline بتاع الـ Task عدى، أو
//   2) isLocked = true (بيتفعّل لما الـ Instructor يقيّم الـ submission -
//      حتى لو ده حصل قبل الـ deadline، عشان التقييم ميبقاش على نسخة اتغيرت بعده)
//
// ملحوظة معمارية مهمة: رفع الـ Submission وحده مبيديش ST فورًا.
// الـ ST (submit +5 / not-submitted -10) بتتحسب بعد ما الـ deadline يعدي
// (Phase 4 scheduled check)، والـ rubric grading (+0 إلى +10) بيحصل
// في أي وقت بعد التسليم بفعل الـ Instructor - مش مرتبط بالـ deadline.

model Submission {
  id        String         @id @default(uuid())
  studentId String
  taskId    String
  mode      SubmissionMode

  // محتوى التسليم - عمود واحد بس هيتملي حسب الـ mode
  fileUrl      String? // لو mode = FILE (مسار الملف في Supabase Storage)
  externalLink String? // لو mode = LINK
  textContent  String? // لو mode = TEXT

  // status: BEGINNER فقط (DRAFT قابل للتعديل ثم SUBMITTED نهائي - يدوي
  // أو auto عند Week.endDate). INTERMEDIATE: يفضل SUBMITTED دايمًا،
  // العمود موجود بس مش بيتغير من قيمته الافتراضية في مساره الحالي.
  status SubmissionStatus @default(SUBMITTED)

  submittedAt DateTime @default(now()) @updatedAt
  isLocked    Boolean  @default(false) // بيتفعّل وقت التقييم، بيمنع أي resubmit بعد كده

  // Evaluation (merged في نفس الـ row - مش جدول منفصل) - INTERMEDIATE فقط.
  // BEGINNER بيستخدم TaskGrade/TaskGradeField بدل الأعمدة دي (rubric
  // متغيرة الحقول، مش 4 أعمدة ثابتة).
  understandingScore  Int? // 0-2
  approachScore       Int? // 0-3
  correctnessScore    Int? // 0-3
  implementationScore Int? // 0-2
  instructorComment   String?
  gradedAt            DateTime?
  gradedBy            String? // instructorId اللي قيّم

  createdAt DateTime @default(now())

  // Relations
  student   Student    @relation(fields: [studentId], references: [id], onDelete: Cascade)
  task      Task       @relation(fields: [taskId], references: [id], onDelete: Cascade)
  taskGrade TaskGrade? // BEGINNER فقط

  @@unique([studentId, taskId])
  @@map("submissions")
}

// ============================================
// TASK GRADE (BEGINNER track only)
// ============================================
// تقييم submission واحدة في نظام الـ BEGINNER. صف واحد بس لكل
// Submission (unique)، بيتربط بمجموعة TaskGradeField (درجة فعلية لكل
// TaskRubricField بتاعة نفس الـ Task).
//
// finalizedAt: null لحد ما الـ Instructor يعمل "submit" نهائي لتقييم
// كل الـ Week بتاعة الطالب ده (انظر grade-week.ts) - في اللحظة دي:
//   1) finalizedAt بيتحدد لكل TaskGrade في الدفعة
//   2) totalPoints بيتحسب (sum كل TaskGradeField.awardedPoints)
//   3) STTransaction بتتعمل بـ amount = totalPoints (أو totalPoints/2
//      لو الملف المطلوب مش ACCEPTED وقتها - wasHalvedDueToLateResource)
// قبل finalizedAt، الصف ده "مسودة تقييم" مالهوش أي STTransaction خالص -
// مفيش PENDING state في STTransaction نفسها، الـ TaskGrade نفسه هو
// الـ staging area.
// زي INTERMEDIATE بالظبط: مفيش تعديل بعد finalizedAt - أي تصحيح محتاج
// تدخل يدوي في الـ DB.

model TaskGrade {
  id           String    @id @default(uuid())
  submissionId String    @unique
  gradedBy     String // instructorId
  totalPoints  Int? // sum كل TaskGradeField.awardedPoints - بيتحسب ويتسجل وقت finalizedAt
  finalizedAt  DateTime? // null = لسه مسودة، مش submitted نهائي
  createdAt    DateTime  @default(now())
  updatedAt    DateTime  @updatedAt

  // Relations
  submission  Submission       @relation(fields: [submissionId], references: [id], onDelete: Cascade)
  fieldScores TaskGradeField[]

  @@map("task_grades")
}

model TaskGradeField {
  id            String   @id @default(uuid())
  taskGradeId   String
  rubricFieldId String
  awardedPoints Int // لازم يكون <= TaskRubricField.maxPoints بتاع نفس الحقل - متفروضة في الـ code
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  // Relations
  taskGrade   TaskGrade       @relation(fields: [taskGradeId], references: [id], onDelete: Cascade)
  rubricField TaskRubricField @relation(fields: [rubricFieldId], references: [id], onDelete: Cascade)

  @@unique([taskGradeId, rubricFieldId])
  @@map("task_grade_fields")
}

// ============================================
// HINT UNLOCK
// ============================================
// بيتبّع مين فتح إيه من الـ Hints. الفتح بيحصل مرة واحدة بس لكل
// (studentId, hintId) - unique constraint - وبعدها الـ Hint مفتوح للأبد.
// costPaid بيسجّل الكلفة وقت الفتح فعليًا (snapshot)، عشان لو الـ cost
// اتغيّر بعدين في الـ Hint نفسها، السجل التاريخي مايتأثرش.

model HintUnlock {
  id         String   @id @default(uuid())
  studentId  String
  hintId     String
  costPaid   Int
  unlockedAt DateTime @default(now())

  // Relations
  student Student @relation(fields: [studentId], references: [id], onDelete: Cascade)
  hint    Hint    @relation(fields: [hintId], references: [id], onDelete: Cascade)

  @@unique([studentId, hintId])
  @@map("hint_unlocks")
}

// ============================================
// ATTENDANCE STATUS ENUM
// ============================================

enum AttendanceStatus {
  PRESENT
  ABSENT
}

// ============================================
// ATTENDANCE
// ============================================
// تسجيل يدوي بالكامل من الـ Instructor أثناء/بعد الـ Session.
// مفيش حالة LATE - PRESENT أو ABSENT بس.
// (studentId, sessionId) unique - تسجيل واحد بس لكل طالب لكل Session.

model Attendance {
  id         String           @id @default(uuid())
  studentId  String
  sessionId  String
  status     AttendanceStatus
  recordedBy String // instructorId اللي سجّل الحضور
  recordedAt DateTime         @default(now())

  // Relations
  student Student @relation(fields: [studentId], references: [id], onDelete: Cascade)
  session Session @relation(fields: [sessionId], references: [id], onDelete: Cascade)

  @@unique([studentId, sessionId])
  @@map("attendance")
}

//--------------------------------------------------------------------------------

// ============================================
// ST TRANSACTION TYPE ENUM
// ============================================

enum STTransactionType {
  REWARD
  PENALTY
}

// ============================================
// ST REASON ENUM
// ============================================
// السبب الثابت اللي خلّى الحركة تحصل. كل الأسباب المتفق عليها في
// نظام الـ ST economy، ثابتة كـ enum عشان consistency و validation
// على مستوى الـ DB.

enum STReason {
  // Rewards
  ATTENDANCE
  SESSION_ENGAGEMENT
  SUBMIT_BEFORE_DEADLINE
  BONUS_TASK_SOLVED
  FIRST_SOLVER
  FINISH_ALL_TASKS
  RUBRIC_GRADING
  WEEKLY_MISSION

  // Penalties
  HINT_UNLOCK
  MISSED_SESSION
  TASK_NOT_SUBMITTED

  // Store
  STORE_PURCHASE

  // Manual
  MANUAL_ADJUSTMENT

  // Level transition (SuperAdmin moves a Group to a new Level -> every
  // student gets a new LevelStBalance row for that Level, starting at
  // 50; logged here for audit purposes)
  LEVEL_RESET
}

// ============================================
// ST TRANSACTION
// ============================================
// سجل تدقيق (audit log) كامل لكل حركة ST تحصل لأي طالب، سواء كانت
// موجبة (REWARD) أو سالبة (PENALTY). amount دايمًا رقم موجب - الإشارة
// بتتحدد من type.
//
// levelId: الـ Level اللي الحركة حصلت فيه فعليًا وقتها - بيتسجّل عشان
// لو الطالب اتنقل لـ Level تاني بعدين، السجل التاريخي يفضل دقيق.
//
// relatedEntityId: عمود generic (من غير FK فعلي) بيخزن ID أي entity
// سبّب الحركة - مثلاً taskId لو SUBMIT_BEFORE_DEADLINE، hintId لو
// HINT_UNLOCK، sessionId لو ATTENDANCE، storeItemId لو STORE_PURCHASE.
//
// levelStBalance / avgStBalance: snapshot لرصيد الطالب مباشرة بعد
// تنفيذ هذه الحركة بالذات - عشان نقدر نعرض تاريخ الرصيد بالظبط في أي
// لحظة من غير ما نضطر نجمع كل الحركات من الأول كل مرة.
// levelStBalance: رصيد LevelStBalance بتاع الـ levelId ده بعد الحركة.
// avgStBalance: قيمة Student.avgSt (المتوسط عبر كل الـ Levels) بعد الحركة.
// (للحركات القديمة قبل المرحلة 2 من الـ avgSt redesign: القيمة دي
// اتترحّلت من totalStBalance القديمة كما هي - سجل تاريخي، مش بيتحسب
// منها حاجة تانية).

// ملحوظة معمارية (BEGINNER track): levelId و weekId بقوا optional الاتنين.
// طالب INTERMEDIATE: levelId مطلوب، weekId لازم يكون null.
// طالب BEGINNER: weekId مطلوب، levelId لازم يكون null.
// الـ "exactly one" ده مش DB constraint - بيتفرض جوه applySTChange() في
// create-transaction.ts حسب نوع الطالب (Student.group.type).
// نفس المنطق بالظبط على snapshot columns: levelStBalance/avgStBalance
// بتتملى لطالب INTERMEDIATE بس، beginnerStBalance بيتملى لطالب BEGINNER بس.

model STTransaction {
  id                         String            @id @default(uuid())
  studentId                  String
  levelId                    String? // مطلوب لطالب INTERMEDIATE فقط، null لطالب BEGINNER
  weekId                     String? // مطلوب لطالب BEGINNER فقط، null لطالب INTERMEDIATE
  type                       STTransactionType
  reason                     STReason
  amount                     Int // دايمًا موجب - دي القيمة بعد الـ ×0.5 لو اتطبق (BEGINNER)، مش القيمة الخام
  relatedEntityId            String? // generic - بدون foreign key فعلي
  levelStBalance             Int? // snapshot بعد الحركة (رصيد الـ Level ده تحديدًا) - INTERMEDIATE فقط
  avgStBalance               Int? // snapshot بعد الحركة (Student.avgSt) - INTERMEDIATE فقط
  beginnerStBalance          Int? // snapshot بعد الحركة (Student.beginnerSt) - BEGINNER فقط
  wasHalvedDueToLateResource Boolean           @default(false) // BEGINNER فقط: true لو الملف المطلوب بتاع الـ Week كان مش accepted وقت الـ grading submit، وبالتالي amount اتضرب ×0.5
  createdAt                  DateTime          @default(now())

  // Relations
  student Student @relation(fields: [studentId], references: [id], onDelete: Cascade)
  level   Level?  @relation(fields: [levelId], references: [id])
  week    Week?   @relation(fields: [weekId], references: [id])

  @@map("st_transactions")
}

// ============================================
// STORE ITEM
// ============================================
// المتجر حاليًا Avatar items بس (ميزة الـ Editorial اتلغت بالكامل
// من العميل). isActive بيسمح للـ SuperAdmin يوقف منتج مؤقتًا من
// غير ما يمسحه (عشان الطلاب اللي امتلكوه يفضل ظاهر عندهم).

model StoreItem {
  id          String   @id @default(uuid())
  name        String
  description String?
  imageUrl    String?
  cost        Int
  isActive    Boolean  @default(true)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  // Relations
  purchases StudentInventory[]

  @@map("store_items")
}

// ============================================
// STUDENT INVENTORY
// ============================================
// إيه اللي الطالب امتلكه فعليًا من الـ Store. (studentId, storeItemId)
// unique - الطالب يقدر يمتلك نفس الـ item مرة واحدة بس، مفيش شراء متكرر.
// isEquipped بيحدد هل الطالب "لابس" الـ item ده دلوقتي في الـ Avatar بتاعه.

model StudentInventory {
  id          String   @id @default(uuid())
  studentId   String
  storeItemId String
  isEquipped  Boolean  @default(false)
  purchasedAt DateTime @default(now())

  // Relations
  student   Student   @relation(fields: [studentId], references: [id], onDelete: Cascade)
  storeItem StoreItem @relation(fields: [storeItemId], references: [id])

  @@unique([studentId, storeItemId])
  @@map("student_inventory")
}

