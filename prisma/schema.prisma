  AURA // مشترك (Glow, Stars, Fire, Lightning, Snow, Electric)
  FRAME // مشترك (عادي، ذهبي، نيون، دايموند)
  HAIR // ولاد + بنات (items مختلفة)
  FACIAL_HAIR // ولاد (ذقن وشنب)
  HAT // مشترك (بما فيها قبعة الساحر)
  HEADPHONES // ولاد
  BOW // بنات
  HAIR_FLOWER // بنات
  NECKLACE // بنات
  EYELASHES // بنات
  HEADBAND // بنات
  CAT_EARS // مستقل
  CYBER_VISOR // مستقل
}

